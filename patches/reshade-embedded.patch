     $<$<CXX_COMPILER_ID:MSVC>:RESHADE_LOCALIZATION>
     $<$<CONFIG:Debug>:RESHADE_VERBOSE_LOG>
     _GDI32_
@@ -314,6 +318,10 @@ target_compile_definitions(
     $<$<CONFIG:Release>:NDEBUG>
 )
 
+if(RESHADE_EMBEDDED_LIBRARY)
+  set_target_properties(ReShade PROPERTIES OUTPUT_NAME "LuminexReShadeRuntime" SUFFIX "${CMAKE_SHARED_LIBRARY_SUFFIX}")
+endif()
+
 if(MSVC)
   target_compile_options(
     ReShade
